@{
    ViewData["Title"]="آموزشیار";
    var hasUsers=Context.HasPermission("Users.View");
    var hasCourses=Context.HasPermission("Courses.View");
    var hasGradesAll=Context.HasPermission("Grades.ViewAll");
    var hasAny=hasUsers || hasCourses || hasGradesAll;
}

<div class="card">
    @if (!hasAny)
    {
        <div class="empty-state">
            <div class="icon-circle icon-warning">!</div>
            <p>شما در حال حاضر به هیچ بخشی دسترسی ندارید. لطفاً با مدیر سیستم تماس بگیرید.</p>
        </div>
    }
    else
    {
        <div class="grid">
            @if (hasUsers)
            {
                <a href="/Users" class="dash-card">
                    <h2>مدیریت کاربران</h2>
                    <p>افزودن، حذف و مدیریت اختیارات کاربران</p>
                </a>
            }

            @if (hasCourses)
            {
                <a href="/Courses" class="dash-card">
                    <h2>مدیریت دروس</h2>
                    <p>افزودن درس، تعیین استاد و ثبت‌نام دانشجو</p>
                </a>
            }

            @if (hasGradesAll)
            {
                <a href="/Reports/AllGrades" class="dash-card">
                    <h2>گزارش کلی نمرات</h2>
                    <p>مشاهده نمرات همه دروس</p>
                </a>
            }
        </div>
    }
</div>