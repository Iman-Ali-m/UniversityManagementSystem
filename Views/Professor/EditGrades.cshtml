@model EditGradesViewModel
@{
    ViewData["Title"]="ویرایش نمرات درس";
}

<div class="card">
    <h1>ویرایش نمرات درس: @Model.CourseName</h1>

    @if (TempData["Error"]!=null)
    {
        <div class="alert alert-error">@TempData["Error"]</div>
    }

    @if (TempData["Success"]!=null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (Model.Rows.Count==0)
    {
        <div class="alert">هیچ دانشجویی در این درس ثبت‌نام نشده است.</div>
    }
    else
    {
        <form method="post" action="/Professor/EditGrades">
            <input type="hidden" name="CourseID" value="@Model.CourseID" />
            <input type="hidden" name="CourseName" value="@Model.CourseName" />

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>دانشجو</th>
                            <th>نمره تمرین</th>
                            <th>نمره امتحان</th>
                            <th>نمره نهایی</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i=0;i<Model.Rows.Count;i++)
                        {
                            <tr>
                                <td>
                                    @Model.Rows[i].StudentName
                                    <input type="hidden" name="Rows[@i].StudentID" value="@Model.Rows[i].StudentID" />
                                </td>
                                <td>
                                    <input type="number" step="0.01" min="0"
                                           name="Rows[@i].AssignmentGrade"
                                           value="@(Model.Rows[i].AssignmentGrade?.ToString() ?? "")" />
                                </td>
                                <td>
                                    <input type="number" step="0.01" min="0"
                                           name="Rows[@i].ExamGrade"
                                           value="@(Model.Rows[i].ExamGrade?.ToString() ?? "")" />
                                </td>
                                <td>
                                    <input type="number" step="0.01" min="0"
                                           name="Rows[@i].FinalGrade"
                                           value="@(Model.Rows[i].FinalGrade?.ToString() ?? "")" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="actions">
                <button type="submit" class="btn">ذخیره تغییرات</button>
                <a href="/Professor/Grades" class="btn">بازگشت</a>
            </div>
        </form>
    }
</div>